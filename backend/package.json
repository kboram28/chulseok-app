{
  "name": "chulseok-backend",
  "version": "1.0.0",
  "description": "출석체크 앱 백엔드 (Express + PostgreSQL)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "db:init": "node --env-file-if-exists=.env scripts/init-db.js",
    "test": "node --env-file-if-exists=.env scripts/smoke-test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "pg": "^8.13.1"
  }
}
